---
/**
 * UK PECR cookie consent banner.
 * Equal-weight Accept / Reject for optional Google Maps.
 * Colours follow each site theme via CSS variables.
 */
interface Props {
  cookiePolicyPath?: string;
}
const { cookiePolicyPath = "/cookie-policy/" } = Astro.props;
---

<div
  id="cookie-consent"
  class="cookie-consent"
  role="dialog"
  aria-modal="false"
  aria-labelledby="cookie-consent-title"
  aria-describedby="cookie-consent-desc"
  hidden
>
  <div class="cookie-consent__panel">
    <div class="cookie-consent__copy">
      <p id="cookie-consent-title" class="cookie-consent__title">Cookies and privacy</p>
      <p id="cookie-consent-desc" class="cookie-consent__text">
        We use essential storage so the site works (for example remembering checklist ticks and your cookie choice).
        Optional Google Maps may set cookies when a map loads. You can accept or reject that. Our quote form loads so you can enquire. See our
        <a href={cookiePolicyPath}>cookie policy</a>.
      </p>
    </div>
    <div class="cookie-consent__actions">
      <button type="button" class="cookie-consent__btn cookie-consent__btn--reject" data-consent="reject">
        Reject optional
      </button>
      <button type="button" class="cookie-consent__btn cookie-consent__btn--accept" data-consent="accept">
        Accept optional
      </button>
    </div>
  </div>
</div>

<style>
  .cookie-consent {
    position: fixed;
    inset-inline: 0;
    bottom: 0;
    z-index: 90;
    padding: 1rem;
    padding-bottom: calc(1rem + env(safe-area-inset-bottom));
    pointer-events: none;
  }
  .cookie-consent[hidden] {
    display: none !important;
  }
  .cookie-consent__panel {
    --cc-bg: var(--color-dark, var(--navy-900, #12314e));
    --cc-fg: #fff;
    --cc-muted: rgb(255 255 255 / 0.84);
    --cc-accept-bg: var(--color-cta, var(--amber, var(--color-brand, #fff)));
    --cc-accept-fg: var(--color-cta-ink, var(--navy-950, var(--color-dark, #0b2540)));
    --cc-accept-hover: var(--color-cta-600, var(--amber-600, var(--color-brand-600, #e8eef5)));
    pointer-events: auto;
    max-width: 52rem;
    margin-inline: auto;
    display: grid;
    gap: 1rem;
    padding: 1.1rem 1.25rem;
    border-radius: 12px;
    background: var(--cc-bg);
    color: var(--cc-fg);
    box-shadow: 0 18px 40px -18px rgb(0 0 0 / 0.45);
    border: 1px solid rgb(255 255 255 / 0.12);
  }
  @media (min-width: 720px) {
    .cookie-consent__panel {
      grid-template-columns: 1fr auto;
      align-items: center;
    }
  }
  .cookie-consent__title {
    margin: 0 0 0.35rem;
    font-family: var(--font-heading, var(--font, inherit));
    font-weight: 700;
    font-size: 1.05rem;
    color: var(--cc-fg);
  }
  .cookie-consent__text {
    margin: 0;
    font-size: 0.92rem;
    line-height: 1.45;
    color: var(--cc-muted);
  }
  .cookie-consent__text a {
    color: var(--cc-fg);
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .cookie-consent__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
  }
  .cookie-consent__btn {
    flex: 1 1 8rem;
    min-height: 2.75rem;
    padding: 0.65rem 1rem;
    border-radius: 10px;
    font-weight: 600;
    font-size: 0.95rem;
    cursor: pointer;
    border: 1px solid transparent;
  }
  .cookie-consent__btn--reject {
    background: transparent;
    color: var(--cc-fg);
    border-color: rgb(255 255 255 / 0.45);
  }
  .cookie-consent__btn--reject:hover,
  .cookie-consent__btn--reject:focus-visible {
    background: rgb(255 255 255 / 0.1);
  }
  .cookie-consent__btn--accept {
    background: var(--cc-accept-bg);
    color: var(--cc-accept-fg);
  }
  .cookie-consent__btn--accept:hover,
  .cookie-consent__btn--accept:focus-visible {
    background: var(--cc-accept-hover);
    color: var(--cc-accept-fg);
  }
  @media (max-width: 1023px) {
    .cookie-consent {
      bottom: calc(64px + env(safe-area-inset-bottom));
    }
  }
</style>

<script>
  import { readConsent, writeConsent } from "../scripts/consent";

  const root = document.getElementById("cookie-consent");
  if (root) {
    const existing = readConsent();
    if (!existing) root.hidden = false;

    root.querySelectorAll<HTMLButtonElement>("[data-consent]").forEach((btn) => {
      btn.addEventListener("click", () => {
        const accept = btn.dataset.consent === "accept";
        writeConsent(accept);
        root.hidden = true;
      });
    });

    document.querySelectorAll<HTMLElement>("[data-open-cookie-settings]").forEach((el) => {
      el.addEventListener("click", (e) => {
        e.preventDefault();
        root.hidden = false;
        root.querySelector<HTMLButtonElement>("[data-consent]")?.focus();
      });
    });
  }
</script>
